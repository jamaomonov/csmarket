{
  "name": "@csmarket/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen:api": "openapi-ts -i ../../docs/api/openapi.json -o src/generated -c @hey-api/client-fetch || echo 'openapi.json not yet generated'"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.5.0"
  },
  "devDependencies": {
    "@csmarket/config-eslint": "workspace:*",
    "@csmarket/config-tsconfig": "workspace:*",
    "@hey-api/openapi-ts": "^0.61.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
