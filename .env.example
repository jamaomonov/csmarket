# csmarket — root .env.example. Copy to .env (gitignored) for the local stack.
POSTGRES_USER=csmarket_app
POSTGRES_PASSWORD=csmarket_app
POSTGRES_DB=csmarket
POSTGRES_PORT=5442
REDIS_PORT=6390

# Every app setting carries the CSMARKET_ prefix (spec §4.2). Compose sets the
# in-network URLs; these are overrides for host processes (make dev-api).
CSMARKET_ENVIRONMENT=dev
CSMARKET_DEBUG=true
CSMARKET_DATABASE_URL=postgresql+asyncpg://csmarket_app:csmarket_app@localhost:5442/csmarket
CSMARKET_REDIS_URL=redis://localhost:6390/0
CSMARKET_CORS_ALLOW_ORIGINS=["http://localhost:3100","http://localhost:3102"]
CSMARKET_LOG_LEVEL=INFO
CSMARKET_LOG_JSON=false
CSMARKET_SENTRY_DSN=

# Auth (M1). Empty JWT keys in dev -> an ephemeral in-process key; prod: ./scripts/gen-secret.sh jwt
CSMARKET_ADMIN_BASE_URL=http://localhost:3102
CSMARKET_JWT_PRIVATE_KEY=
CSMARKET_JWT_PUBLIC_KEY=
CSMARKET_STEAM_API_KEY=
CSMARKET_WAXPEER_API_KEY=
# true only where the Waxpeer key works (prod); the import alone also runs in dev
CSMARKET_SKINS_SYNC_ENABLED=false
CSMARKET_DEV_LOGIN_ENABLED=true

# Money (M3). Kassa credentials — prod only; tests and dev use the mock provider.
CSMARKET_CLICK_MERCHANT_ID=
CSMARKET_CLICK_SERVICE_ID=
CSMARKET_CLICK_SECRET_KEY=
CSMARKET_PAYME_MERCHANT_ID=
CSMARKET_PAYME_KEY=
CSMARKET_PAYME_TEST_KEY=
CSMARKET_UZUM_SERVICE_ID=
CSMARKET_UZUM_LOGIN=
CSMARKET_UZUM_PASSWORD=
CSMARKET_UZUM_TEST_LOGIN=
CSMARKET_UZUM_TEST_PASSWORD=
# Defaults (uncomment to override): top-up limits and expiry, kassa URLs and the Payme login.
# CSMARKET_TOPUP_MIN_UZS=1000
# CSMARKET_TOPUP_MAX_UZS=10000000
# CSMARKET_TOPUP_EXPIRY_MINUTES=30
# CSMARKET_CLICK_PAY_URL=https://my.click.uz/services/pay
# CSMARKET_PAYME_LOGIN=Paycom
# CSMARKET_PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# CSMARKET_UZUM_OPEN_SERVICE_URL=https://uzumbank.uz/open-service

# Frontends
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
