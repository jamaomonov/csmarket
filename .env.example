# csmarket — root .env.example. Copy to .env (gitignored) for the local stack.
POSTGRES_USER=csmarket_app
POSTGRES_PASSWORD=csmarket_app
POSTGRES_DB=csmarket
POSTGRES_PORT=5442
REDIS_PORT=6390

# Every app setting carries the CSMARKET_ prefix (spec §4.2). Compose sets the
# in-network URLs; these are overrides for host processes (make dev-api).
CSMARKET_ENVIRONMENT=dev
CSMARKET_DEBUG=true
CSMARKET_DATABASE_URL=postgresql+asyncpg://csmarket_app:csmarket_app@localhost:5442/csmarket
CSMARKET_REDIS_URL=redis://localhost:6390/0
CSMARKET_CORS_ALLOW_ORIGINS=["http://localhost:3100","http://localhost:3102"]
CSMARKET_LOG_LEVEL=INFO
CSMARKET_LOG_JSON=false
CSMARKET_SENTRY_DSN=

# Auth (M1). Empty JWT keys in dev -> an ephemeral in-process key; prod: ./scripts/gen-secret.sh jwt
CSMARKET_ADMIN_BASE_URL=http://localhost:3102
CSMARKET_JWT_PRIVATE_KEY=
CSMARKET_JWT_PUBLIC_KEY=
CSMARKET_STEAM_API_KEY=
CSMARKET_WAXPEER_API_KEY=
# Skinslink — the second buy source (spec 2026-10-06). Off until both keys are set.
CSMARKET_SKINSLINK_ENABLED=false
CSMARKET_SKINSLINK_API_KEY=
CSMARKET_SKINSLINK_SECRET=
# true only where the Waxpeer key works (prod); the import alone also runs in dev
CSMARKET_SKINS_SYNC_ENABLED=false
CSMARKET_DEV_LOGIN_ENABLED=true
# Email (M4b). dev keeps the last 50 letters in Redis (GET /api/v1/dev/emails); prod uses
# resend and refuses dev. No Resend key is needed locally.
CSMARKET_EMAIL_TRANSPORT=dev
CSMARKET_RESEND_API_KEY=

# Money (M3). Kassa credentials — prod only; tests and dev use the mock provider.
CSMARKET_CLICK_MERCHANT_ID=
CSMARKET_CLICK_SERVICE_ID=
CSMARKET_CLICK_SECRET_KEY=
CSMARKET_PAYME_MERCHANT_ID=
CSMARKET_PAYME_KEY=
CSMARKET_PAYME_TEST_KEY=
CSMARKET_UZUM_SERVICE_ID=
CSMARKET_UZUM_LOGIN=
CSMARKET_UZUM_PASSWORD=
CSMARKET_UZUM_TEST_LOGIN=
CSMARKET_UZUM_TEST_PASSWORD=
# Prod only: accept the Payme test key and the Uzum sandbox pair (R14 sandbox pass, then off).
# Outside prod sandbox credentials always count.
# CSMARKET_KASSA_SANDBOX_ENABLED=false
# Defaults (uncomment to override): top-up limits and expiry, kassa URLs and the Payme login.
# CSMARKET_TOPUP_MIN_UZS=1000
# CSMARKET_TOPUP_MAX_UZS=10000000
# CSMARKET_TOPUP_EXPIRY_MINUTES=30
# CSMARKET_CLICK_PAY_URL=https://my.click.uz/services/pay
# CSMARKET_PAYME_LOGIN=Paycom
# CSMARKET_PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# CSMARKET_UZUM_OPEN_SERVICE_URL=https://uzumbank.uz/open-service

# Orders (M4a). Buying is off by default; the dev compose turns it on for its containers.
# CSMARKET_SKINS_BUY_ENABLED=false
# Dev and e2e only: an in-process fake Waxpeer (trades in Redis), so local buys spend nothing.
# The dev compose turns it on; a host process (make dev-api / dev-worker / dev-scheduler) needs
# it here. Prod refuses to start with it. With a real CSMARKET_WAXPEER_API_KEY and the fake
# off, a local buy is a REAL purchase with real money.
# CSMARKET_WAXPEER_FAKE=true
# Defaults (uncomment to override):
# CSMARKET_ORDER_EXPIRY_MINUTES=15
# CSMARKET_ORDER_PRICE_TOLERANCE=0.02
# CSMARKET_ORDER_SUBSTITUTE_CEILING=0.03
# CSMARKET_ORDER_UNCONFIRMED_MINUTES=10
# CSMARKET_TRADES_RECONCILE_SECONDS=10
# CSMARKET_WAXPEER_BUY_TIMEOUT_SECONDS=20
# Dev and e2e only: divide every scheduler job's first-run delay (the dev compose sets 10, so
# the reconcile sweep runs ~24 s after `make dev`). Prod refuses anything but 1.
# CSMARKET_SCHEDULER_FIRST_RUN_DIVISOR=1
# Ops signals: the alert WaxpeerBalanceLow fires below this many USD; the worker and scheduler
# serve /metrics on these ports (compose network only, not published).
# CSMARKET_WAXPEER_BALANCE_ALERT_USD=50
# CSMARKET_WORKER_METRICS_PORT=9101
# CSMARKET_SCHEDULER_METRICS_PORT=9102

# Frontends
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100

# Percent added to the CBU USD/UZS rate for soʻm prices (ADR-0011). Prod sets 1 in
# docker-compose.prod.yml, which wins over this file.
CSMARKET_FX_UPLIFT_PCT=0

# Waxpeer as a buy source (off in prod via docker-compose.prod.yml: Skinslink resells its
# listings cheaper). Waxpeer still brings Steam prices and checks trade links.
CSMARKET_WAXPEER_BUY_ENABLED=true
