# Host-run API (`make dev-api`, port 8100) against the dev compose's Postgres and
# Redis — csmarket's own host ports (5442, 6390), so it never reaches another
# stack running on the defaults. Copy to apps/api/.env.
CSMARKET_ENVIRONMENT=dev
CSMARKET_DEBUG=true
CSMARKET_SERVICE_NAME=csmarket-api
CSMARKET_BASE_URL=http://localhost:8100
CSMARKET_WEB_BASE_URL=http://localhost:3100
CSMARKET_DATABASE_URL=postgresql+asyncpg://csmarket_app:csmarket_app@localhost:5442/csmarket
CSMARKET_REDIS_URL=redis://localhost:6390/0
CSMARKET_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3100","http://localhost:3102","http://localhost:5173"]
CSMARKET_APP_ENC_KEY=
CSMARKET_SENTRY_DSN=
CSMARKET_LOG_LEVEL=INFO
CSMARKET_LOG_JSON=false
