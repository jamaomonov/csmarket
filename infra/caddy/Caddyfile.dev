# Local dev with internal TLS so HTTPS works on *.localhost.
{
	local_certs
	auto_https disable_redirects
}

csmarket.localhost {
	tls internal
	reverse_proxy web:3000
}

admin.localhost {
	tls internal
	reverse_proxy admin:5173
}

api.localhost {
	tls internal
	reverse_proxy api:8000 {
		# As in prod: only the storefront's direct calls may name a visitor (ADR-0003).
		header_up -X-Storefront-Secret
		header_up -X-Storefront-Client-Ip
	}
}
