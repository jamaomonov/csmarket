# Caddy — production: the stack's own edge. It owns :80/:443 on the VPS (csmarket is
# alone on its box — ADR-0003), terminates TLS with Let's Encrypt, and routes by host.
#
#   csmarket.uz, www.csmarket.uz → web (Next.js)
#   admin.csmarket.uz            → admin (nginx + static Vite build)
#   api.csmarket.uz              → FastAPI (+ WebSocket from M4)
#   grafana.csmarket.uz          → Grafana, gated by basic-auth
#
# Cloudflare proxies every hostname (SSL mode "Full (strict)"). ACME HTTP-01
# passes through the proxy, so certificates are ordinary Let's Encrypt.
#
# CLIENT IP — load-bearing. FastAPI's ``client_ip()`` trusts the FIRST entry of
# X-Forwarded-For (rate limiter, and ip_guard from M1). So this file must hand it
# exactly one value, the real visitor: ``trusted_proxies`` names Cloudflare's
# ranges, ``client_ip_headers`` tells Caddy to read Cf-Connecting-Ip from those
# peers only, and every upstream block OVERWRITES X-Forwarded-For with
# {client_ip}. A direct hit from a non-Cloudflare address gets its socket peer and
# cannot inject a chain. If this is ever changed to append, both guards are
# worthless — see the comment in apps/api/src/csmarket/core/client_ip.py.
#
# Ranges from https://www.cloudflare.com/ips-v4 and /ips-v6 (2026-10-01). A new
# range simply falls through as its own edge IP; refresh the list when CF publishes.
#
# Editing this file on prod needs ``up -d --force-recreate caddy``: it is a
# single-file bind mount and ``git checkout`` swaps the inode under a reload.

# PII — the owner's rule is "never log Steam ID, email, IP, trade-link token", and
# promtail ships Caddy's stdout to Loki. Caddy's request object carries the
# visitor's address (remote_ip, client_ip), every header (Cf-Connecting-Ip,
# X-Forwarded-For, Cookie, User-Agent, Referer) and the full URI, whose query
# string carries the Steam ID on the OpenID callback from M1. Dropping every header
# also drops ``Authorization``, which on the kassa webhooks is the acquirer's Basic
# credential (Payme ``Paycom:<key>``, Uzum login:password) — a secret, not just PII.
# This filter keeps
# method, host, path, status, size and duration and drops the rest. It is
# applied to the access log AND to Caddy's default logger: handler errors
# (``http.log.error.*`` — an upstream refusing a connection, say) go there with
# the same unfiltered request object.
(pii_filter) {
	format filter {
		wrap json
		fields {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>uri regexp \?.*$ ""
			resp_headers delete
		}
	}
}

{
	email {$ACME_EMAIL}
	log default {
		output stdout
		import pii_filter
	}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

(upstream) {
	# Hold and retry across a container restart instead of answering 502:
	# deploys are stop-then-start and the gap is 5–15 s.
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "interest-cohort=()"
	}
}

(access_log) {
	# Caddy logs no request lines by default; promtail ships stdout to Loki.
	# Filtered: see (pii_filter) at the top.
	log {
		output stdout
		import pii_filter
	}
}

# ---------- storefront ----------
csmarket.uz, www.csmarket.uz {
	encode zstd gzip
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.csmarket.uz wss://api.csmarket.uz; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	@www host www.csmarket.uz
	redir @www https://csmarket.uz{uri} permanent
	import access_log
	import upstream web:3000
}

# ---------- admin ----------
admin.csmarket.uz {
	encode zstd gzip
	import security_headers
	import access_log
	import upstream admin:80
}

# ---------- api ----------
api.csmarket.uz {
	encode zstd gzip
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	# CORS is FastAPI's job (CSMARKET_CORS_ALLOW_ORIGINS); doing it here too
	# produces two Access-Control-Allow-Origin values and the browser rejects both.

	# Prometheus scrapes api:8000 on the internal network; never from the public host.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# Payme's Merchant API (JSON-RPC) accepts calls only from Payme's documented
	# source range 185.234.113.1-185.234.113.15 (the /28 below covers .0-.15).
	# Defense-in-depth beside the app-layer Basic Auth check (-32504 in
	# csmarket.modules.payme.routes); it does not replace it.
	#
	# Must be ``client_ip``, never ``remote_ip`` (ADR-0003): Cloudflare sits in
	# front, so the socket peer is always a Cloudflare address. ``client_ip`` is
	# Cf-Connecting-Ip, honoured only from the Cloudflare ranges trusted in the
	# global options above. This matcher doubles as a canary for that wiring: if
	# the edge ever resolves a Cloudflare address instead of the visitor, every
	# genuine Payme call 403s here and top-ups through Payme stop.
	@paymeMerchantBlocked {
		path /api/v1/payments/payme/merchant
		not client_ip 185.234.113.0/28
	}
	respond @paymeMerchantBlocked 403

	# Uzum Bank Merchant API webhook allowlist — DEFERRED, NOT ACTIVE.
	# Unlike Payme, Uzum has not documented its webhook source IPs. Until it
	# confirms a range, the app-layer Basic Auth check (errorCode 10001 in
	# csmarket.modules.uzum.routes) is the only gate on this path, and that is
	# sufficient on its own.
	#
	# Do NOT uncomment this with a guessed CIDR: a wrong range would 403 genuine
	# Uzum callbacks, and a matcher left with an empty or placeholder client_ip
	# list would 403 all traffic on this path. Once Uzum confirms the IPs, fill in
	# <UZUM_IPS>, uncomment, and validate with `caddy validate` before reloading.
	#
	# @uzumMerchantBlocked {
	# 	path /api/v1/payments/uzum/*
	# 	not client_ip <UZUM_IPS>
	# }
	# respond @uzumMerchantBlocked 403

	# Rate limiting lives in FastAPI (slowapi); Caddy's rate_limit needs a custom
	# build. Volumetric abuse is Cloudflare's WAF.
	import access_log
	import upstream api:8000
}

# ---------- grafana (operators only) ----------
grafana.csmarket.uz {
	encode zstd gzip
	basic_auth {
		ops {$GRAFANA_BASIC_AUTH_HASH}
	}
	# Strip Caddy's basic-auth credentials before they reach Grafana: Grafana
	# would try them as its own basic auth and answer 401 (the two passwords
	# differ on purpose). Grafana then shows its own login form.
	reverse_proxy grafana:3000 {
		header_up -Authorization
	}
}
