# Runtime config for api / worker / scheduler. Compose mounts the same file into
# all three. Every key carries the CSMARKET_ prefix (spec §4.2).

# ----- Database / Redis -----
CSMARKET_DATABASE_URL=postgresql+asyncpg://csmarket_app:CHANGE_ME_match_postgres_env@postgres:5432/csmarket
# Password must match REDIS_PASSWORD in redis.env (requirepass).
CSMARKET_REDIS_URL=redis://:CHANGE_ME_match_redis_env@redis:6379/0

# ----- Public URLs -----
CSMARKET_BASE_URL=https://api.csmarket.uz
CSMARKET_WEB_BASE_URL=https://csmarket.uz
CSMARKET_CORS_ALLOW_ORIGINS=["https://csmarket.uz","https://admin.csmarket.uz"]
CSMARKET_ADMIN_BASE_URL=https://admin.csmarket.uz

# ----- At-rest encryption (core.crypto) -----
# 32 random bytes, base64. Generate: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Rotating it makes every encrypted row unreadable — keep an offline copy.
CSMARKET_APP_ENC_KEY=CHANGE_ME_base64_32_bytes

# ----- Observability -----
CSMARKET_SENTRY_DSN=
CSMARKET_SENTRY_TRACES_SAMPLE_RATE=0.1
CSMARKET_LOG_LEVEL=INFO
CSMARKET_LOG_JSON=true

# ----- Auth (M1) -----
# Ed25519 pair, each PEM base64-encoded on one line: ./scripts/gen-secret.sh jwt
# Rotating the private key signs everyone out.
CSMARKET_JWT_PRIVATE_KEY=CHANGE_ME_base64_pem
CSMARKET_JWT_PUBLIC_KEY=CHANGE_ME_base64_pem
# Steam Web API key, issued per domain at steamcommunity.com/dev/apikey for csmarket.uz
# (YuPay's key does not work here).
CSMARKET_STEAM_API_KEY=CHANGE_ME_steam_web_api_key
# IP-whitelisted to the VPS at Waxpeer.
CSMARKET_WAXPEER_API_KEY=CHANGE_ME_waxpeer_api_key
# Scheduler runs the ByMykel import and the Waxpeer price sync.
CSMARKET_SKINS_SYNC_ENABLED=true
# Never on in prod (ignored there anyway).
CSMARKET_DEV_LOGIN_ENABLED=false

# ----- Money (M3): kassa credentials -----
# Leave a kassa empty to keep it off; its webhook then refuses and its tile is hidden.
# Click cabinet (my.click.uz): the service's merchant id, service id and SECRET_KEY.
CSMARKET_CLICK_MERCHANT_ID=CHANGE_ME_click_merchant_id
CSMARKET_CLICK_SERVICE_ID=CHANGE_ME_click_service_id
CSMARKET_CLICK_SECRET_KEY=CHANGE_ME_click_secret_key
# Payme cabinet (merchant.paycom.uz): the cash register id, its «Ключ» and «Тестовый ключ».
CSMARKET_PAYME_MERCHANT_ID=CHANGE_ME_payme_merchant_id
CSMARKET_PAYME_KEY=CHANGE_ME_payme_key
CSMARKET_PAYME_TEST_KEY=CHANGE_ME_payme_test_key
# Uzum: the service id and the login/password pairs their engineer hands over (prod and test).
CSMARKET_UZUM_SERVICE_ID=CHANGE_ME_uzum_service_id
CSMARKET_UZUM_LOGIN=CHANGE_ME_uzum_login
CSMARKET_UZUM_PASSWORD=CHANGE_ME_uzum_password
CSMARKET_UZUM_TEST_LOGIN=CHANGE_ME_uzum_test_login
CSMARKET_UZUM_TEST_PASSWORD=CHANGE_ME_uzum_test_password
# Defaults, set only to override (docs/runbooks/kassa-setup.md):
# CSMARKET_CLICK_PAY_URL=https://my.click.uz/services/pay
# CSMARKET_PAYME_LOGIN=Paycom
# Payme sandbox: https://test.paycom.uz; remove the line at go-live.
# CSMARKET_PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# CSMARKET_UZUM_OPEN_SERVICE_URL=https://uzumbank.uz/open-service
# Owner decision D1; expiry of a top-up no kassa took up.
# CSMARKET_TOPUP_MIN_UZS=1000
# CSMARKET_TOPUP_MAX_UZS=10000000
# CSMARKET_TOPUP_EXPIRY_MINUTES=30
