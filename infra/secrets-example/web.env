# Public Next.js storefront. NEXT_PUBLIC_* are shipped to the browser in the JS
# bundle, so keep them strictly public.
# NOTE: NEXT_PUBLIC_* are inlined at `next build` (CI build-args), so this
# file is documentation for them — the build-arg is what actually reaches the bundle.
NEXT_PUBLIC_API_BASE_URL=https://api.csmarket.uz

# Server-only (read at runtime by the Node server, never in the bundle): the SAME value as
# CSMARKET_STOREFRONT_SECRET in secrets/api.env (ADR-0003). Never rename it NEXT_PUBLIC_*.
CSMARKET_STOREFRONT_SECRET=CHANGE_ME_same_as_api_env

# Landing (optional): support and social links; empty hides them.
CSMARKET_TELEGRAM_URL=
CSMARKET_SOCIAL_URLS=
