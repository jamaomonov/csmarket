# Read by the caddy container; Caddy substitutes these into the {$ACME_EMAIL} and
# {$GRAFANA_BASIC_AUTH_HASH} placeholders in infra/caddy/Caddyfile.prod.

# Let's Encrypt expiry notices land here.
ACME_EMAIL=CHANGE_ME_ops_mailbox

# Gates grafana.csmarket.uz. Generate with:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps caddy \
#     caddy hash-password --plaintext "the-real-password"
#
# ESCAPE EVERY "$" AS "$$". Compose interpolates env_file values, and a bcrypt
# hash is full of them: in ``$2a$14$G3qsw…`` it reads ``$G3qsw…`` as a variable
# name, substitutes the empty string, and hands Caddy a truncated hash. The
# failure is silent and total — the login page still prompts, but no password on
# earth authenticates. Compose collapses each ``$$`` back to one ``$``, so what
# reaches Caddy is exactly what hash-password printed.
#
#   hash-password prints:  $2a$14$G3qsw…
#   this file must say:    $$2a$$14$$G3qsw…
#
# Verify after deploying — this must print 60, not 42:
#   docker compose -f docker-compose.prod.yml exec -T caddy \
#     sh -c 'printenv GRAFANA_BASIC_AUTH_HASH | tr -d "\n" | wc -c'
GRAFANA_BASIC_AUTH_HASH=CHANGE_ME_bcrypt_hash_with_every_dollar_doubled

# Search indexing of csmarket.uz (docs/runbooks/indexing.md). Closed unless exactly "on":
# robots.txt disallows everything and every response carries X-Robots-Tag: noindex.
# Flip to "on" only on the owner's word, then: up -d --force-recreate caddy
CSMARKET_INDEXING=off

