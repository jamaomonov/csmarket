{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeOut": {
        "description": "The signed-in account as its owner sees it (the trade link is theirs to see).",
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "enum": [
              "ru",
              "uz",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "steam_id": {
            "title": "Steam Id",
            "type": "string"
          },
          "trade_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Link"
          },
          "trade_link_checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Link Checked At"
          },
          "trade_link_reason": {
            "anyOf": [
              {
                "enum": [
                  "invalid",
                  "private",
                  "trade_ban",
                  "hold",
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Link Reason"
          },
          "trade_link_verdict": {
            "anyOf": [
              {
                "enum": [
                  "ok",
                  "warn",
                  "bad"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Link Verdict"
          }
        },
        "required": [
          "id",
          "steam_id",
          "display_name",
          "avatar_url",
          "email",
          "email_verified",
          "locale",
          "trade_link",
          "trade_link_verdict",
          "trade_link_reason",
          "trade_link_checked_at",
          "roles",
          "created_at"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MePatchIn": {
        "additionalProperties": false,
        "description": "Editable profile fields; omitted = unchanged, ``email: null`` = clear.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "format": "email",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "locale": {
            "anyOf": [
              {
                "enum": [
                  "ru",
                  "uz",
                  "en"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          }
        },
        "title": "MePatchIn",
        "type": "object"
      },
      "SteamCallbackIn": {
        "additionalProperties": false,
        "description": "The ``openid.*`` params exactly as Steam appended them, and which app asked.",
        "properties": {
          "app": {
            "enum": [
              "web",
              "admin"
            ],
            "title": "App",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 32,
            "minProperties": 4,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "app",
          "params"
        ],
        "title": "SteamCallbackIn",
        "type": "object"
      },
      "TokensOut": {
        "description": "Response for any endpoint that opens or rotates a session.\n\nThe refresh token is intentionally absent: it is delivered as an ``HttpOnly`` cookie\n(see :mod:`csmarket.modules.auth.cookies`) so JS cannot read it. Only the short-lived\naccess token \u2014 which the app attaches as a Bearer header \u2014 is returned in the body.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokensOut",
        "type": "object"
      },
      "TradeLinkIn": {
        "additionalProperties": false,
        "description": "A pasted trade link.",
        "properties": {
          "url": {
            "maxLength": 300,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "TradeLinkIn",
        "type": "object"
      },
      "TradeLinkOut": {
        "description": "The saved link and its last check.",
        "properties": {
          "checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "invalid",
                  "private",
                  "trade_ban",
                  "hold",
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "trade_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Link"
          },
          "verdict": {
            "anyOf": [
              {
                "enum": [
                  "ok",
                  "warn",
                  "bad"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          }
        },
        "required": [
          "trade_link",
          "verdict",
          "reason",
          "checked_at"
        ],
        "title": "TradeLinkOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "csmarket API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revoke this session and clear the cookie.\n\nIdempotent: unknown or already-revoked tokens succeed silently, which is also why it\ntakes no ``Idempotency-Key``.",
        "operationId": "logout_route_api_v1_auth_logout_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "cookie",
            "name": "csmarket_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Csmarket Refresh"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Rotate-on-use; the reuse trip-wire lives in the service.\n\nKeyless: rotation is inherently single-use, a replay is the attack it detects. Must\nwrite nothing before :func:`refresh_session` \u2014 on reuse the service commits its\nburn-down, which would commit any earlier pending write too.",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "parameters": [
          {
            "in": "cookie",
            "name": "csmarket_refresh",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Csmarket Refresh"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rotate the refresh cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/steam": {
      "post": {
        "description": "Verify the callback with Steam and open a session.\n\nKeyless by design: replaying an OpenID assertion is refused by Steam itself\n(``check_authentication`` succeeds once), so an ``Idempotency-Key`` adds nothing.",
        "operationId": "steam_complete_api_v1_auth_steam_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SteamCallbackIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete a Steam sign-in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/steam/start": {
      "get": {
        "description": "Send the browser to Steam.\n\n``return_to`` is the app's own callback page; realm is the app's origin. Both come\nfrom settings \u2014 the query only picks which app, so the redirect cannot be aimed\nanywhere else.",
        "operationId": "steam_start_api_v1_auth_steam_start_get",
        "parameters": [
          {
            "in": "query",
            "name": "app",
            "required": false,
            "schema": {
              "default": "web",
              "enum": [
                "web",
                "admin"
              ],
              "title": "App",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "default": "ru",
              "enum": [
                "ru",
                "uz",
                "en"
              ],
              "title": "Locale",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Begin a Steam sign-in (302 to steamcommunity.com)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "Profile, roles and trade-link state.",
        "operationId": "get_me_api_v1_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The signed-in account",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "description": "Partial update; replays a stored response for a repeated ``Idempotency-Key``.",
        "operationId": "patch_me_api_v1_me_patch",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MePatchIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Edit locale or email",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/trade-link": {
      "put": {
        "description": "Parse, require that it is this account's own link, save. No external call.",
        "operationId": "put_trade_link_api_v1_me_trade_link_put",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TradeLinkIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeLinkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save my trade link",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/trade-link/check": {
      "post": {
        "description": "Advisory check of the saved link (AGENTS \u00a711 carve-out).\n\nKeyless on purpose: it writes only the derived verdict of a link the user already\nsaved, and re-running it is the intended use; the 10-minute cache makes a repeat free.",
        "operationId": "check_my_trade_link_api_v1_me_trade_link_check_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeLinkOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check my trade link",
        "tags": [
          "me"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Return ``{\"status\": \"ok\"}`` if the process is alive.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "meta"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "200 when Postgres and Redis answer; 503 with the failing check named otherwise.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is down"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
